#!/bin/bash
# Grants the active seat user access to this machine's Logitech Unifying and
# Bolt receiver hidraw nodes. Meant to be run via `pkexec` from the plugin
# panel's "Fix permissions" button, or by hand with sudo.
#
# The rules match the hidraw node's own HID device by its DEVPATH, whose last
# HID component carries the receiver's product ID
# (.../0003:046D:C52B.0004/hidraw/hidraw0). Matching ATTRS{idProduct} on the
# USB device instead also tagged every device paired to the receiver: the
# kernel's logitech-dj driver exposes each paired keyboard and mouse as a
# child HID device with its own hidraw node under the same USB device
# (.../0003:046D:C52B.0004/0003:046D:4076.0005/hidraw/hidraw2), and uaccess
# on those lets any of the user's processes read raw keystrokes. udev matches
# DEVPATH with fnmatch(3) without FNM_PATHNAME, so the fixed four hex digits
# keep the pattern from spanning into a child's path. hidpp-receiver only
# ever opens the receiver's own node, so nothing it does needs the others.
#
# Known gap: a Bolt receiver also exposes boot-keyboard/boot-mouse
# interfaces whose HID devices carry the receiver's product ID, so the C548
# rule still covers those.
set -euo pipefail

RULES_FILE="/etc/udev/rules.d/72-logi-receivers.rules"

cat > "$RULES_FILE" <<'RULES'
# Installed by the axelfontaine.logitech-bolt / axel.logi-unifying Omarchy shell plugins.
# Grants the active seat user read/write access to the receivers' own hidraw
# nodes only - not to the keyboards and mice paired to them, and not to
# hidraw devices generally.
SUBSYSTEM=="hidraw", DEVPATH=="*/0003:046D:C52B.[0-9A-F][0-9A-F][0-9A-F][0-9A-F]/hidraw/hidraw*", TAG+="uaccess"
SUBSYSTEM=="hidraw", DEVPATH=="*/0003:046D:C532.[0-9A-F][0-9A-F][0-9A-F][0-9A-F]/hidraw/hidraw*", TAG+="uaccess"
SUBSYSTEM=="hidraw", DEVPATH=="*/0003:046D:C548.[0-9A-F][0-9A-F][0-9A-F][0-9A-F]/hidraw/hidraw*", TAG+="uaccess"
RULES

udevadm control --reload

# A plain (default "change") trigger does not make systemd-logind re-derive
# ACLs for devices that are already present — neither to grant a newly-added
# uaccess tag nor to revoke one that was removed. Only a real remove-then-add
# cycle (equivalent to a physical replug) does. Verified empirically on this
# machine: a "change" trigger left every one of these hidraw nodes with no
# ACL for the seat user at all, even though the just-reloaded rule granted
# one.
udevadm trigger --action=remove --subsystem-match=hidraw
udevadm trigger --action=add --subsystem-match=hidraw
